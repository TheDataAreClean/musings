<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {# Earlier versions and changes pages of a post point search engines and
     link previews at the latest version (see doc.njk for vinfo) #}
  {% set vinfo = versions[page.inputPath] or (versions["./" + versionOf] if versionOf else null) %}
  {% set canonicalUrl = vinfo.latest.url if versionOf and vinfo else page.url %}
  <title>{% if title and title != "Home" %}{{ title }}{% if changesFrom %} (changes in version {{ (changesFrom | int) + 1 }}){% elif versionOf %} (version {{ version }}){% endif %} | {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.author }}">
  <meta name="robots" content="noindex, nofollow, noarchive, noimageindex">
  <meta property="og:title" content="{% if title and title != "Home" %}{{ title }}{% else %}{{ site.title }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.title }}">
  {% set ogImageSlugValue = canonicalUrl | ogImageSlug %}
  {% if ogImageSlugValue | ogImageExists %}
  {# Generated at build time by scripts/generate-og-images.js — a real
     screenshot of the site's own doc-chrome, not a generic social card.
     ogImageSlug/ogImageExists are the same functions that script uses to
     name and check for the file, so this can't drift from what's on disk —
     if no PNG was generated for a page, these tags are simply omitted. #}
  <meta property="og:image" content="{{ site.url }}/images/og/{{ ogImageSlugValue }}.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ site.url }}/images/og/{{ ogImageSlugValue }}.png">
  {% else %}
  <meta name="twitter:card" content="summary">
  {% endif %}
  <meta name="theme-color" content="#f0f0f0">
  <link rel="canonical" href="{{ site.url }}{{ canonicalUrl }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
  {# Favicon stack: ICO for bookmark managers/RSS readers, SVG for modern browsers,
     apple-touch-icon for iOS Safari home screen, manifest for Android Chrome.
     All four are passthrough-copied from src/ — see .eleventy.js. #}
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.json">
  <link rel="stylesheet" href="/css/main.css?v={{ assetVersion }}">
  {% if "margin-note" in content %}
  {# Hide inline margin notes until comments.js has built its cards, so they
     don't paint and then vanish (layout shift). The timer un-hides them if
     the script never runs. #}
  <script>document.documentElement.classList.add('comments-pending');setTimeout(function(){document.documentElement.classList.remove('comments-pending')},3000)</script>
  {% endif %}
</head>
<body>

  {# ── APPLICATION CHROME — decoration, with a few working controls ────── #}
  {# Working: File and Help menus, outline, font, text size, ¶ marks, zoom,
     red stoplight. Everything else is dead text. All of it is aria-hidden:
     the real navigation lives in the document (nav.njk). #}

  {# Title bar: stoplight left · document name centre · save state right #}
  <div class="app-titlebar" aria-hidden="true">
    <div class="app-titlebar__left">
      <div class="stoplight">
        <button class="stoplight__red" title="Close tab"></button>
        <span class="stoplight__yellow"></span>
        <span class="stoplight__green"></span>
      </div>
    </div>
    <span class="app-titlebar__doc">{{ title or site.shortTitle }}</span>
    <span class="app-titlebar__saved">{{ site.chrome.saveState }}</span>
  </div>

  {# Menu bar: File and Help open real menus; the rest are dead text #}
  <div class="app-menubar" aria-hidden="true">
    {% for item in site.chrome.menu %}
    {% if item == "File" %}
    <span class="app-menubar__item app-menu">File
      <div class="app-menu__panel">
        <div class="app-menu__option" data-action="random">New<span class="app-menu__hint">random post</span><span class="app-menu__key">⌘N</span></div>
        <div class="app-menu__option" data-href="/">Open…<span class="app-menu__hint">all posts</span><span class="app-menu__key">⌘O</span></div>
        <div class="app-menu__sep"></div>
        <div class="app-menu__option" data-action="copy-link">Copy link<span class="app-menu__key">⌘L</span></div>
        <div class="app-menu__option" data-href="/feed.xml">Subscribe<span class="app-menu__hint">RSS feed</span></div>
        {% if vinfo %}<div class="app-menu__option" data-action="versions">Version history<span class="app-menu__hint">{{ vinfo.all.length }} versions</span></div>
        {% endif %}<div class="app-menu__option" data-action="print">Print / PDF<span class="app-menu__key">⌘P</span></div>
        <div class="app-menu__sep"></div>
        <div class="app-menu__option" data-action="close">Close tab<span class="app-menu__key">⌘W</span></div>
      </div>
    </span>
    {% elif item == "Help" %}
    <span class="app-menubar__item app-menu app-menu--right">Help
      <div class="app-menu__panel">
        <div class="app-menu__label">Keyboard shortcuts</div>
        <div class="app-menu__option" data-action="zoom-in">Zoom in<span class="app-menu__key">⌘+</span></div>
        <div class="app-menu__option" data-action="zoom-out">Zoom out<span class="app-menu__key">⌘−</span></div>
        <div class="app-menu__option" data-action="zoom-reset">Actual size<span class="app-menu__key">⌘0</span></div>
        <div class="app-menu__sep"></div>
        <div class="app-menu__option" data-href="/about/">About {{ site.shortTitle }}</div>
      </div>
    </span>
    {% else %}
    <span class="app-menubar__item">{{ item }}</span>
    {% endif %}
    {% endfor %}
  </div>

  {# Toolbar: realistic content, denser, correct glyphs #}
  <div class="app-toolbar" aria-hidden="true">
    {# Outline: reads "Normal text" until the script finds headings to list #}
    <span class="app-dropdown app-toolbar__outline">
      <span class="app-dropdown__label">{{ site.chrome.styleLabel }}</span>&#8200;&#9662;
      <div class="app-dropdown__menu"></div>
    </span>
    <span class="app-toolbar__pipe">|</span>
    <span class="app-dropdown app-toolbar__font" aria-hidden="true">
      <span class="app-dropdown__label">Georgia</span>&#8200;&#9662;
      <div class="app-dropdown__menu">
        <div class="app-dropdown__option" data-value="arial">Arial</div>
        <div class="app-dropdown__option app-dropdown__option--selected" data-value="georgia">Georgia</div>
      </div>
    </span>
    <span class="app-dropdown app-toolbar__size">
      <span class="app-dropdown__label">{{ site.chrome.fontSize }}</span>&#8200;&#9662;
      <div class="app-dropdown__menu">
        {% for size in [10, 11, 12, 14, 16, 18] %}
        <div class="app-dropdown__option{% if size == site.chrome.fontSize | int %} app-dropdown__option--selected{% endif %}" data-value="{{ size }}">{{ size }}</div>
        {% endfor %}
      </div>
    </span>
    <span class="app-toolbar__pipe">|</span>
    <b class="app-toolbar__fmt app-toolbar__mobile-hide">B</b>
    <i class="app-toolbar__fmt app-toolbar__mobile-hide">I</i>
    <u class="app-toolbar__fmt app-toolbar__mobile-hide">U</u>
    <s class="app-toolbar__fmt app-toolbar__mobile-hide">S</s>
    <span class="app-toolbar__pipe app-toolbar__mobile-hide">|</span>
    <span class="app-toolbar__fmt app-toolbar__mobile-hide">A ▾</span>
    <span class="app-toolbar__fmt app-toolbar__marks" title="Show formatting marks">¶</span>
    <span class="app-toolbar__pipe app-toolbar__mobile-hide">|</span>
    <span class="app-toolbar__break"></span>
    {# Icons are inline SVG, not glyphs: no font draws all four alignments.
       Alignment icons differ only in the short lines' offset and width. #}
    {% macro alignIcon(x, w, active) %}<span class="app-toolbar__fmt app-toolbar__icon{% if active %} app-toolbar__fmt--active{% endif %} app-toolbar__mobile-hide"><svg viewBox="0 0 14 12"><rect y="0.5" width="14" height="1.2"/><rect x="{{ x }}" y="3" width="{{ w }}" height="1.2"/><rect y="5.5" width="14" height="1.2"/><rect x="{{ x }}" y="8" width="{{ w }}" height="1.2"/><rect y="10.5" width="14" height="1.2"/></svg></span>{% endmacro %}
    {{ alignIcon(0, 9, true) }}
    {{ alignIcon(2.5, 9) }}
    {{ alignIcon(5, 9) }}
    {{ alignIcon(0, 14) }}
    <span class="app-toolbar__pipe app-toolbar__mobile-hide">|</span>
    <span class="app-toolbar__fmt app-toolbar__icon app-toolbar__mobile-hide"><svg viewBox="0 0 14 12"><rect y="0.5" width="14" height="1.2"/><rect x="6" y="3" width="8" height="1.2"/><rect x="6" y="5.5" width="8" height="1.2"/><rect x="6" y="8" width="8" height="1.2"/><rect y="10.5" width="14" height="1.2"/><polygon points="4,3.4 4,8.6 0.5,6"/></svg></span>
    <span class="app-toolbar__fmt app-toolbar__icon app-toolbar__mobile-hide"><svg viewBox="0 0 14 12"><rect y="0.5" width="14" height="1.2"/><rect x="6" y="3" width="8" height="1.2"/><rect x="6" y="5.5" width="8" height="1.2"/><rect x="6" y="8" width="8" height="1.2"/><rect y="10.5" width="14" height="1.2"/><polygon points="0.5,3.4 0.5,8.6 4,6"/></svg></span>
    <span class="app-toolbar__spacer app-toolbar__mobile-hide"></span>
    <span class="app-dropdown app-dropdown--right app-toolbar__zoom" aria-hidden="true">
      <span class="app-dropdown__label">100%</span>&#8200;&#9662;
      <div class="app-dropdown__menu">
        <div class="app-dropdown__option" data-value="50">50%</div>
        <div class="app-dropdown__option" data-value="75">75%</div>
        <div class="app-dropdown__option" data-value="90">90%</div>
        <div class="app-dropdown__option app-dropdown__option--selected" data-value="100">100%</div>
        <div class="app-dropdown__option" data-value="110">110%</div>
        <div class="app-dropdown__option" data-value="125">125%</div>
        <div class="app-dropdown__option" data-value="150">150%</div>
        <div class="app-dropdown__option" data-value="175">175%</div>
        <div class="app-dropdown__option" data-value="200">200%</div>
      </div>
    </span>
  </div>

  {# Ruler: tick marks + inch numbers in HTML #}
  <div class="app-ruler" aria-hidden="true">
    <div class="app-ruler__zone">
      <span class="app-ruler__num" style="--i: 1">1</span>
      <span class="app-ruler__num" style="--i: 2">2</span>
      <span class="app-ruler__num" style="--i: 3">3</span>
      <span class="app-ruler__num" style="--i: 4">4</span>
      <span class="app-ruler__num" style="--i: 5">5</span>
      <span class="app-ruler__num" style="--i: 6">6</span>
    </div>
  </div>

  {# ── REAL CONTENT LIVES HERE ─────────────────────────────────────────── #}

  <div class="app-canvas">
    <main id="main" role="main">
      {{ content | safe }}
    </main>
  </div>

  {# Status bar — page, word count and zoom are live; language is decoration #}
  <div class="app-statusbar" aria-hidden="true">
    <span class="app-statusbar__item app-statusbar__page">Page 1</span>
    <span class="app-statusbar__item app-statusbar__words" hidden></span>
    <span class="app-statusbar__item app-statusbar__msg" hidden></span>
    <span class="app-statusbar__item app-statusbar__lang">{{ site.chrome.language }}</span>
    <span class="app-statusbar__spacer"></span>
    <span class="app-statusbar__item app-statusbar__zoom">{{ site.chrome.zoom }}</span>
  </div>

  <script>
  (function () {

    // ── Shared: custom dropdown ───────────────────────────────────────────────
    function initDropdown(el, onChange, keepLabel) {
      var label   = el.querySelector('.app-dropdown__label');
      var options = el.querySelectorAll('.app-dropdown__option');

      el.addEventListener('click', function (e) {
        e.stopPropagation();
        var isOpen = el.classList.contains('app-dropdown--open');
        closeAll();
        if (!isOpen) el.classList.add('app-dropdown--open');
      });

      options.forEach(function (opt) {
        opt.addEventListener('click', function (e) {
          e.stopPropagation();
          options.forEach(function (o) { o.classList.remove('app-dropdown__option--selected'); });
          opt.classList.add('app-dropdown__option--selected');
          if (!keepLabel) label.textContent = opt.textContent;
          el.classList.remove('app-dropdown--open');
          if (onChange) onChange(opt.dataset.value);
        });
      });

      return {
        setValue: function (val) {
          options.forEach(function (o) {
            var match = o.dataset.value === String(val);
            o.classList.toggle('app-dropdown__option--selected', match);
            if (match) label.textContent = o.textContent;
          });
        }
      };
    }

    function closeAll() {
      document.querySelectorAll('.app-dropdown--open, .app-menu--open').forEach(function (d) {
        d.classList.remove('app-dropdown--open', 'app-menu--open');
      });
    }

    document.addEventListener('click', closeAll);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeAll();
    });

    // ── 0. VISIT — formatting carries across pages within one visit only ─────
    // A fresh arrival (typed URL, bookmark, link from another site) clears the
    // saved font, size, zoom and ¶. Moving between pages, reload and back/forward
    // keep them. Storage stays sessionStorage, so a new tab is fresh too.
    var KEY = { font: 'musings-font', size: 'musings-size', zoom: 'musings-zoom', marks: 'musings-marks' };
    try {
      var navEntry = performance.getEntriesByType('navigation')[0];
      var navType  = navEntry ? navEntry.type : 'navigate';
      var internal = document.referrer && new URL(document.referrer).origin === location.origin;
      if (navType === 'navigate' && !internal) {
        Object.keys(KEY).forEach(function (k) { sessionStorage.removeItem(KEY[k]); });
      }
    } catch (err) {}

    // ── 1. FONT — persists within a visit ────────────────────────────────────
    var fontMap = {
      arial:   'Arial, Helvetica, sans-serif',
      georgia: 'Georgia, "Times New Roman", serif'
    };

    function applyFont(key) {
      document.documentElement.style.setProperty('--font-doc', fontMap[key] || fontMap.arial);
      sessionStorage.setItem(KEY.font, key);
    }

    var fontDropdown = initDropdown(document.querySelector('.app-toolbar__font'), applyFont);

    var savedFont = sessionStorage.getItem(KEY.font);
    if (savedFont && fontMap[savedFont]) {
      applyFont(savedFont);
      fontDropdown.setValue(savedFont);
    }

    // ── 2. ZOOM — session-persistent, Cmd/Ctrl +/-/0 ─────────────────────────
    var zoomDropdown = initDropdown(document.querySelector('.app-toolbar__zoom'), function (value) {
      applyZoom(levels.indexOf(Number(value)));
    });

    var zoomStatus = document.querySelector('.app-statusbar__zoom');
    var canvas     = document.querySelector('.app-canvas');
    var levels     = [50, 75, 90, 100, 110, 125, 150, 175, 200];
    var zi         = levels.indexOf(100);

    function applyZoom(i) {
      zi = Math.max(0, Math.min(levels.length - 1, i));
      var pct = levels[zi];
      canvas.style.zoom      = pct / 100;
      zoomStatus.textContent = pct + '%';
      zoomDropdown.setValue(pct);
      sessionStorage.setItem(KEY.zoom, pct);
    }

    var savedZoom = sessionStorage.getItem(KEY.zoom);
    if (savedZoom) applyZoom(levels.indexOf(Number(savedZoom)));

    document.addEventListener('keydown', function (e) {
      if (!e.metaKey && !e.ctrlKey) return;
      if (e.key === '=' || e.key === '+') { e.preventDefault(); applyZoom(zi + 1); }
      else if (e.key === '-')             { e.preventDefault(); applyZoom(zi - 1); }
      else if (e.key === '0')             { e.preventDefault(); applyZoom(levels.indexOf(100)); }
    });

    // ── 3. TEXT SIZE — scales document text only, persists within a visit ────
    // 12 is the 1rem baseline; --doc-scale feeds the type scale inside .doc-page
    function applySize(pt) {
      document.documentElement.style.setProperty('--doc-scale', pt / 12);
      sessionStorage.setItem(KEY.size, pt);
    }

    var sizeDropdown = initDropdown(document.querySelector('.app-toolbar__size'), function (value) {
      applySize(Number(value));
    });

    var savedSize = sessionStorage.getItem(KEY.size);
    if (savedSize && document.querySelector('.app-toolbar__size [data-value="' + savedSize + '"]')) {
      applySize(Number(savedSize));
      sizeDropdown.setValue(savedSize);
    }

    // ── 4. OUTLINE — the style picker lists the post's headings ──────────────
    var outline  = document.querySelector('.app-toolbar__outline');
    var headings = document.querySelectorAll('.doc-body h2[id], .doc-body h3[id]');
    if (headings.length) {
      var outlineMenu = outline.querySelector('.app-dropdown__menu');
      headings.forEach(function (h) {
        var opt = document.createElement('div');
        opt.className = 'app-dropdown__option' + (h.tagName === 'H3' ? ' app-dropdown__option--sub' : '');
        opt.dataset.value = h.id;
        opt.textContent = h.textContent.trim();
        outlineMenu.appendChild(opt);
      });
      outline.querySelector('.app-dropdown__label').textContent = 'Outline';
      initDropdown(outline, function (id) { location.hash = id; }, true);
    } else {
      outline.classList.add('app-dropdown--empty');
    }

    // ── 5. FORMATTING MARKS — ¶ shows a pilcrow after every paragraph ────────
    var marks = document.querySelector('.app-toolbar__marks');

    function applyMarks(on) {
      document.documentElement.classList.toggle('show-marks', on);
      marks.classList.toggle('app-toolbar__fmt--active', on);
      sessionStorage.setItem(KEY.marks, on ? '1' : '');
    }

    marks.addEventListener('click', function () {
      applyMarks(!document.documentElement.classList.contains('show-marks'));
    });
    if (sessionStorage.getItem(KEY.marks)) applyMarks(true);

    // ── 6. STATUS BAR — page x of y (page breaks), word count, messages ─────
    var pageStatus = document.querySelector('.app-statusbar__page');
    var breaks     = document.querySelectorAll('.doc-body .page-break');

    var shownPage = 0;
    function updatePage() {
      var line = window.innerHeight / 2;
      var current = 1;
      breaks.forEach(function (b) {
        if (b.getBoundingClientRect().top < line) current++;
      });
      if (current === shownPage) return;
      shownPage = current;
      pageStatus.textContent = 'Page ' + current + ' of ' + (breaks.length + 1);
    }

    // Without page breaks the count can never change, so there is nothing to track
    if (breaks.length) {
      var pageTick = false;
      window.addEventListener('scroll', function () {
        if (pageTick) return;
        pageTick = true;
        requestAnimationFrame(function () { pageTick = false; updatePage(); });
      }, { passive: true });
    }
    updatePage();

    var post = document.querySelector('.doc-page[data-words]');
    if (post) {
      var words = document.querySelector('.app-statusbar__words');
      words.textContent = Number(post.dataset.words).toLocaleString('en-GB') + ' words · ' +
        post.dataset.readtime + ' min read';
      words.hidden = false;
    }

    var msg = document.querySelector('.app-statusbar__msg');
    var msgTimer;
    function flash(text) {
      msg.textContent = text;
      msg.hidden = false;
      clearTimeout(msgTimer);
      msgTimer = setTimeout(function () { msg.hidden = true; }, 2000);
    }

    // ── 7. MENU BAR — File and Help ──────────────────────────────────────────
    // Shortcut hints are labels only; the browser keeps ⌘N/⌘P/⌘W.
    if (!/Mac|iPhone|iPad/.test(navigator.platform)) {
      document.querySelectorAll('.app-menu__key').forEach(function (k) {
        k.textContent = k.textContent.replace('⌘', 'Ctrl+');
      });
    }

    var menus = document.querySelectorAll('.app-menu');
    menus.forEach(function (menu) {
      menu.addEventListener('click', function (e) {
        e.stopPropagation();
        if (e.target.closest('.app-menu__panel')) return;
        var isOpen = menu.classList.contains('app-menu--open');
        closeAll();
        if (!isOpen) menu.classList.add('app-menu--open');
      });
      // Like a real menu bar: once one menu is open, hovering opens its neighbour
      menu.addEventListener('mouseenter', function () {
        if (!document.querySelector('.app-menu--open') || menu.classList.contains('app-menu--open')) return;
        closeAll();
        menu.classList.add('app-menu--open');
      });
    });

    var actions = {
      random: function () {
        fetch('/posts.json').then(function (r) { return r.json(); }).then(function (all) {
          var urls = all.filter(function (u) { return u !== location.pathname; });
          if (urls.length) location.href = urls[Math.floor(Math.random() * urls.length)];
        }, function () { flash('Could not load posts'); });
      },
      'copy-link': function () {
        var url = location.href.split('#')[0];
        if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(function () { flash('Link copied'); },
                                                  function () { flash(url); });
        } else {
          flash(url);
        }
      },
      print:        function () { window.print(); },
      versions:     function () { openVersions(true); },
      close:        function () { window.close(); },
      'zoom-in':    function () { applyZoom(zi + 1); },
      'zoom-out':   function () { applyZoom(zi - 1); },
      'zoom-reset': function () { applyZoom(levels.indexOf(100)); }
    };

    document.querySelectorAll('.app-menu__option').forEach(function (opt) {
      opt.addEventListener('click', function (e) {
        e.stopPropagation();
        closeAll();
        if (opt.dataset.href) location.href = opt.dataset.href;
        else if (actions[opt.dataset.action]) actions[opt.dataset.action](opt);
      });
    });

    // Version history: File → Version history and the meta line's "version n"
    // link open the <details id="versions"> panel under the meta line
    function openVersions(scroll) {
      var panel = document.getElementById('versions');
      if (!panel) return;
      panel.open = true;
      if (scroll) panel.scrollIntoView({ block: 'start' });
    }
    if (location.hash === '#versions') openVersions(false);
    window.addEventListener('hashchange', function () {
      if (location.hash === '#versions') openVersions(false);
    });

    // ── 8. STOPLIGHT — red closes tab; all dots dim on window blur ────────────
    document.querySelector('.stoplight__red').addEventListener('click', actions.close);

    var titlebar = document.querySelector('.app-titlebar');
    var stoplight = document.querySelector('.stoplight');

    function setActive(active) {
      titlebar.classList.toggle('app-titlebar--inactive', !active);
      stoplight.classList.toggle('stoplight--inactive', !active);
    }

    window.addEventListener('blur',  function () { setActive(false); });
    window.addEventListener('focus', function () { setActive(true);  });
    document.addEventListener('visibilitychange', function () {
      setActive(!document.hidden);
    });

  })();
  </script>
  {% if "margin-note" in content %}<script src="/js/comments.js?v={{ assetVersion }}" defer></script>{% endif %}
</body>
</html>
