---
layout: layouts/base.njk
ogType: article
---
{# Post versions: vinfo is the post's version history (src/_data/versions.js).
   A snapshot page (src/versions/) and a changes page (src/changes.njk) find it
   through versionOf, the live post's source path. #}
{% set vinfo = versions[page.inputPath] or (versions["./" + versionOf] if versionOf else null) %}
{% set shownTags = postTags or tags %}
{% if date %}{% set words = content | wordcount %}{% set readtime = content | readtime %}{% endif %}
<article class="doc-page{% if not hidePostNav %} doc-page--with-nav{% endif %}"{% if date %} data-words="{{ words }}" data-readtime="{{ readtime }}"{% endif %}>

  {# Reader views and apps that pull a post from its page (Reeder, Safari
     Reader, blogrolls) should show what the feed shows: the description, then
     the body. Extractors drop a heading that repeats the title and every
     <footer>, on every pass, so the title is an <h1> and the nav and the
     meta/tags lines sit in footers (display: contents, so the layout doesn't
     change). Not a <header>: it can't hold a footer, and its class must not
     contain "header", which Readability's first pass strips with the
     description inside. #}
  <div class="doc-head">

  <h1 class="doc-title">{{ title }}</h1>

  <footer class="doc-head__nav">{% set navRss = true %}{% include "nav.njk" %}</footer>

  {% if description %}<p class="doc-description">{{ description }}</p>{% endif %}

  {% if versionOf %}{% set postSection = versionOf.split("/")[1] %}{% elif shownTags and ("snaps" in shownTags) %}{% set postSection = "snaps" %}{% elif shownTags and ("notes" in shownTags) %}{% set postSection = "notes" %}{% else %}{% set postSection = "ideas" %}{% endif %}
  {% if postSection == "snaps" %}
    {% set sectionLabel = "snaps" %}
    {% set sectionUrl = "/snaps/" %}
  {% elif postSection == "notes" %}
    {% set sectionLabel = "notes" %}
    {% set sectionUrl = "/notes/" %}
  {% else %}
    {% set sectionLabel = "ideas" %}
    {% set sectionUrl = "/ideas/" %}
  {% endif %}

  {% if not hideMeta %}
  <footer class="doc-head__info">
  <p class="doc-meta">
    {% if date %}
      <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
      {% if words %}· {{ words }} words
      · {{ readtime }} min read{% endif %}
    {% endif %}
    · <a href="{{ sectionUrl }}">{{ sectionLabel }}</a>
  </p>
  {% if shownTags | collectionTags | length %}
  <p class="doc-tags">
    {% for tag in shownTags | collectionTags %}<a class="post-tag" href="/tags/{{ tag | tagSlug }}/">{{ tag }}</a>{% endfor %}
  </p>
  {% endif %}
  </footer>
  {% endif %}

  </div>

  {% if vinfo %}
  {# The version line and its footnote are the document's only version note;
     the history itself is the titlebar menu (base.njk), aria-hidden like all
     chrome. The latest version's note is shared with the feed
     (version-notes.njk). #}
  {% import "version-notes.njk" as notes %}
  {% set backref %} <a href="#fnref-version" class="footnote-backref">↩︎</a></p>
</li>
{% endset %}
  {% if changesFrom %}
  {% set newerV = vinfo.byVersion[changesTo] %}{% set olderV = vinfo.byVersion[changesFrom] %}
  {% set was = [] %}
  {% if oldTitle != title %}{% set _ = was.push(["the title", "was", oldTitle]) %}{% endif %}
  {% if oldDescription != description %}{% set _ = was.push(["the description", "was", oldDescription]) %}{% endif %}
  {% if oldTags != newTags %}{% set _ = was.push(["the tags", "were", oldTags]) %}{% endif %}
  <p class="version-line">These are the edits made on {{ newerV.date | readableDate }}{{ notes.mark() }}</p>
  {% set versionFootnote %}<li id="fn-version" class="footnote-item footnote-item--version"><p>{{ notes.editNote(newerV) }} Red is removed, green is added.{% if was | length %} {{ was | beforeSentence | safe }}{% endif %} <a href="{{ vinfo.latest.url }}">Latest version</a> · <a href="{{ olderV.url }}">Previous version</a>{{ backref | safe }}{% endset %}
  {% elif versionOf %}
  {% set thisV = vinfo.byVersion[version] %}{% set nextV = thisV.nextVersion %}
  {# Latest, middle and original footnotes run in one order: note (or
     "Edited on …"), then "What changed", then the other version #}
  <p class="version-line">This is {{ "the original" if thisV.original else "an older" }} version of this post, from {{ versionDate | readableDate }}{{ notes.mark() }}</p>
  {% set versionFootnote %}<li id="fn-version" class="footnote-item footnote-item--version"><p>{% if thisV.changesUrl %}{{ notes.editNote(thisV) }} <a href="{{ thisV.changesUrl }}">What changed</a> · <a href="{{ vinfo.latest.url }}">Latest version</a>{% else %}{% if nextV %}Edited on {{ nextV.date | readableDate }}. <a href="{{ nextV.changesUrl }}">What changed</a> · {% endif %}<a href="{{ vinfo.latest.url }}">Latest version</a>{% endif %}{{ backref | safe }}{% endset %}
  {% else %}
  <p class="version-line">{{ notes.latestLine(vinfo) }}</p>
  {% set versionFootnote = notes.latestFootnote(vinfo, "") %}
  {% endif %}
  {% endif %}

  <div class="doc-layout">

    {# data-source is the "where it came from" line print.css adds at the end.
       An attribute, not a hidden element: reader views that ignore [hidden]
       (Mercury and the like) printed the URL as the post's last line. #}
    <div class="doc-layout__content" data-source="{{ site.url | replace("https://", "") }}{{ page.url }}">
      <div class="doc-body">
        {% if vinfo %}{{ content | withVersionFootnote(versionFootnote) | safe }}{% else %}{{ content | safe }}{% endif %}
      </div>

      {% if not hidePostNav %}
      <footer class="doc-foot">
      <nav class="post-nav" aria-label="Post navigation">
        <div class="post-nav__prev">
          <a href="{{ sectionUrl }}">← More {{ sectionLabel }}</a>
        </div>
        <div class="post-nav__next">
          <a href="/">All posts →</a>
        </div>
      </nav>
      </footer>
      {% endif %}
    </div>


  </div>

</article>
