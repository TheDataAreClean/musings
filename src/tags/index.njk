---
layout: layouts/base.njk
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: /tags/{{ tag | tagSlug }}/
eleventyComputed:
  title: "{{ tag | safe }}"
  description: "{% set n = (collections[tag] | published).length %}{{ n }} post{% if n != 1 %}s{% endif %} tagged as {{ tag | safe }}."
eleventyExcludeFromCollections: true
---

<div class="doc-page">

  <p class="doc-title"><mark>{{ tag }}</mark></p>

  {% include "nav.njk" %}

  {# sort: reverse=true, caseSensitive=false, attr="date" #}
  {% set listPosts = collections[tag] | published | sort(true, false, "date") %}{% set listSigils = true %}{% set listTags = false %}{% set listEmpty = 'No posts tagged "' + tag + '".' %}
  {% include "post-list.njk" %}

</div>
